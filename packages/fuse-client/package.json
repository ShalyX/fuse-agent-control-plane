{
  "name": "@fuse/fuse-client",
  "version": "0.1.0",
  "private": false,
  "description": "Typed TypeScript client for the Fuse bounded-inference control plane.",
  "files": ["dist", "README.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/ShalyX/fuse-agent-control-plane.git",
    "directory": "packages/fuse-client"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  }
}
